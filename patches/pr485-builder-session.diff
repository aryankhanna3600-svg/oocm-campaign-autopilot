+/** How long a design claim holds before it counts as abandoned (a crash or restart mid-run). */
+export const DESIGN_LEASE_MINUTES = 6;
+
+/** Atomic claim on the design run, kept in tweaks.designing_since. */
+export async function claimDesign(id: number): Promise<boolean> {
+  const rows = await CreateDBConnection.query(
+    `UPDATE campaign_builder_session
+        SET tweaks = COALESCE(tweaks, '{}'::jsonb) || jsonb_build_object('designing_since', to_char(NOW() AT TIME ZONE 'UTC', 'YYYY-MM-DD"T"HH24:MI:SS"Z"'))
+      WHERE id = $1::int
+        AND (tweaks->>'designing_since' IS NULL
+             OR (tweaks->>'designing_since')::timestamptz < NOW() - ($2::int * INTERVAL '1 minute'))
+      RETURNING id`,
+    [id, DESIGN_LEASE_MINUTES],
+  );
+  return returnedRows(rows).length > 0;
+}
+
+export async function releaseDesign(id: number): Promise<void> {
+  try {
+    await CreateDBConnection.query(`UPDATE campaign_builder_session SET tweaks = tweaks - 'designing_since' WHERE id = $1::int AND tweaks ? 'designing_since'`, [id]);
+  } catch { /* the lease expires on its own */ }
+}
+
+/** True while a design run holds a live claim. Read by the session view so a reloaded page keeps waiting. */
+export function isDesigning(tweaks: Record<string, unknown> | null | undefined, now = Date.now()): boolean {
+  const at = tweaks && typeof tweaks.designing_since === "string" ? Date.parse(tweaks.designing_since) : NaN;
+  return Number.isFinite(at) && now - at < DESIGN_LEASE_MINUTES * 60_000;
+}
