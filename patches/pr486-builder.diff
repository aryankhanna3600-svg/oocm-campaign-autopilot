-export interface Picks { objective?: Objective; deal?: "barter" | "paid"; platform?: "Instagram" | "YouTube" }
+export interface Picks {
+  objective?: Objective; deal?: "barter" | "paid"; platform?: "Instagram" | "YouTube";
+  /** "Design again" with the brand's own numbers (3-Nov). Each applies to every card. */
+  count?: number;
+  /** What each creator posts on Instagram. YouTube cards stay one Short. */
+  format?: "reel" | "reel_story" | "reel_2story" | "stories";
+  /** All live by this day (YYYY-MM-DD). */
+  by?: string;
+}
+
+/** Clean the brand's own numbers: whole creators 1-500, a known format, a date from tomorrow to 90 days out. */
+export function cleanOwnNumbers(raw: Record<string, unknown> | null | undefined, now = new Date()): Pick<Picks, "count" | "format" | "by"> {
+  const out: Pick<Picks, "count" | "format" | "by"> = {};
+  const n = Math.floor(Number(raw?.count));
+  if (Number.isFinite(n) && n >= 1 && n <= 500) out.count = n;
+  const f = String(raw?.format ?? "");
+  if (["reel", "reel_story", "reel_2story", "stories"].includes(f)) out.format = f as Picks["format"];
+  const by = String(raw?.by ?? "");
+  if (/^\d{4}-\d{2}-\d{2}$/.test(by)) {
+    const t = Date.parse(`${by}T00:00:00Z`);
+    const today = Date.parse(`${now.toISOString().slice(0, 10)}T00:00:00Z`);
+    if (Number.isFinite(t) && t >= today + DAY && t <= today + 90 * DAY) out.by = by;
+  }
+  return out;
+}
 
